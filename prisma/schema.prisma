  @@unique([companyId, code])
  @@index([companyId])
  @@index([regionId])
  @@index([partnerGroupId])
  @@index([parentId])
  @@schema("wms")
}

// Müşteri (cari) ↔ kullanılabilir tesis (kısıtlama-listesi): kayıt yoksa müşteri TÜM tesislerde; varsa yalnız listedekiler.
model TBLPARTNERFACILITY {
  id         Int      @id @default(autoincrement())
  companyId  Int
  partnerId  Int
  facilityId Int
  createdAt  DateTime @default(now())

  partner TBLBUSINESSPARTNER @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, facilityId])
  @@index([companyId])
  @@index([partnerId])
  @@schema("wms")
}

// ── Cari ek grup / ek saha / kabul zamanı / optimizasyon (legacy TBLMUSTERI* ) ──

// Müşteri Ek Grup — master (legacy TBLMUSTERIEKGRUP)
model TBLPARTNEREXTRAGROUP {
