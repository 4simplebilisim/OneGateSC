// Yazıcı tanımı (bizim eklediğimiz — legacy Excel'de yok) — etiket basımı + mDNS/IPP ağ keşfi
model TBLPRINTER {
  id         Int         @id @default(autoincrement())
  companyId  Int
  code       String      @db.VarChar(40)
  name       String?     @db.VarChar(120)
  type       PrinterType @default(IPP)
  host       String?     @db.VarChar(120) // IP veya hostname
  port       Int? // IPP genelde 631, ZPL ham 9100
  path       String?     @db.VarChar(200) // IPP yolu, ör. /ipp/print
  location   String?     @db.VarChar(120) // fiziksel konum etiketi
  isDefault  Boolean     @default(false)
  discovered Boolean     @default(false) // mDNS ile mi bulundu
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  company TBLCOMPANY @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

enum PrinterType {
  IPP // ağ yazıcısı (IPP/CUPS)
  ZPL // termal Zebra (ham ZPL, TCP 9100)
  SYSTEM // tarayıcı/OS diyaloğu

  @@schema("wms")
}

