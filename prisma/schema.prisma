  orderDate     DateTime         @default(now())
  requestedDate DateTime?
  currency      String           @default("TRY") @db.VarChar(3)
  exchangeRate  Decimal          @default(1) @db.Decimal(18, 6)
  subTotal      Decimal          @default(0) @db.Decimal(18, 4)
  discountTotal Decimal          @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal          @default(0) @db.Decimal(18, 4)
  totalAmount   Decimal          @default(0) @db.Decimal(18, 4)
  note          String?          @db.VarChar(500)
  createdById   Int // → wms.TBLUSER
  approvedById  Int?
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lines TBLSALESORDERLINE[]

  @@unique([companyId, orderNo])
  @@index([companyId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@schema("sales")
}

model TBLSALESORDERLINE {
  id             Int      @id @default(autoincrement())
  orderId        Int
  lineNo         Int
  productId      Int // → wms.TBLPRODUCT
  unitId         Int // → wms.TBLUNIT
  quantity       Decimal  @db.Decimal(28, 8)
  shippedQty     Decimal  @default(0) @db.Decimal(28, 8)
  allocatedQty   Decimal  @default(0) @db.Decimal(28, 8)
  unitPrice      Decimal  @default(0) @db.Decimal(18, 4)
  discountRate   Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 4)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 4)
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order       TBLSALESORDER        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations TBLSALESALLOCATION[]

  @@unique([orderId, lineNo])
  @@index([orderId])
  @@index([productId])
  @@schema("sales")
}

// Satış stok ayırma (allocation) — sipariş satırını WMS stok satırına gevşek bağlar (stockId)
model TBLSALESALLOCATION {
  id          Int      @id @default(autoincrement())
  orderLineId Int
  stockId     Int // → wms.TBLSTOCK (gevşek bağ, cross-schema FK yok)
  quantity    Decimal  @db.Decimal(28, 8)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderLine TBLSALESORDERLINE @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([orderLineId])
  @@index([stockId])
  @@schema("sales")
}

enum SalesOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED

  @@schema("sales")
}

