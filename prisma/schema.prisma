model TBLLABELTEMPLATE {
  id          Int      @id @default(autoincrement())
  companyId   Int
  code        String   @db.VarChar(40) // TXTKOD
  screenTitle String?  @db.VarChar(120) // TXTEKRANBASLIK
  labelName   String?  @db.VarChar(120) // TXTETIKETADI
  menuGroupId Int? // LNGMENUGRUPKOD
  displayType Int? // BYTGOSTERIMTIP
  reportType  Int? // BYTRAPORTIP
  col1Count   Int? // LNGKOLON1SAYI
  col2Count   Int?
  col3Count   Int?
  col1Length  Int?
  col2Length  Int?
  password    String?  @db.VarChar(40) // TXTSIFRE
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items   TBLLABELTEMPLATEITEM[]
  queries TBLLABELTEMPLATEQUERY[]

