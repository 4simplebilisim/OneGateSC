// ----------------------------------------------------------------------------
// Sayım (stocktake) — fiziksel sayım, sistem ile karşılaştır, fark düzelt (wms)
// Operasyonel referanslar gevşek Int (intra-schema, index'li).
// ----------------------------------------------------------------------------

model TBLSTOCKCOUNT {
  id          Int         @id @default(autoincrement())
  companyId   Int
  countNo     String      @db.VarChar(40)
  warehouseId Int
  countType   String?     @db.VarChar(20) // Sayım Tipi (ZSYM vb.)
  status      CountStatus @default(DRAFT)
  countDate   DateTime    @default(now())
  note        String?     @db.VarChar(500)
  // Kapsam kısıtları (StokBar Sayım Belge — Bağlantı Tipi: Hepsi/Grup/Kod)
  materialLinkType LinkScope? // Malzeme Bağlantı Tipi — ALL(Hepsi)/GROUP(Grup)/SPECIFIC(Kod)
  materialLinkId   Int?       // GROUP→ürün grubu, SPECIFIC→ürün
  userLinkType     LinkScope? // Kullanıcı Bağlantı Tipi
  userLinkId       Int?       // GROUP→kullanıcı grubu, SPECIFIC→kullanıcı
  // Sayım Parametreleri (TBLCOUNTPARAMETER) — sayım operasyonundan çözülür
  operationTypeId  Int?       // Sayım Operasyonu (parametre kaynağı)
  equalize         Boolean  @default(true) // Eşitleme — false ise tamamlamada stok DÜZELTİLMEZ (yalnız fark raporu)
  createdById Int
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines TBLSTOCKCOUNTLINE[]

  @@unique([companyId, countNo])
  @@index([companyId])
  @@index([warehouseId])
  @@index([status])
  @@schema("wms")
}

model TBLSTOCKCOUNTLINE {
  id         Int      @id @default(autoincrement())
  companyId Int // tenant (cok-kiracilik) - parent kaydin companyId siyle ayni
  countId    Int
  lineNo     Int
  stockId    Int?
  locationId Int
  productId  Int
  statusId   Int
  unitId     Int
  batchNo    String?  @db.VarChar(100)
  serialNo   String?  @db.VarChar(100)
