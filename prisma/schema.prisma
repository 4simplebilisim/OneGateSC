// ============================================================================
// PROCUREMENT modülü — satınalma (schema: procurement)
// wms'e GEVŞEK bağlı: wms entity'leri id ile referanslanır (cross-schema FK yok),
// referans bütünlüğü uygulama katmanında doğrulanır. Modüller ayrı kalır.
// ============================================================================

model TBLPURCHASEORDER {
  id            Int                 @id @default(autoincrement())
  companyId     Int
  orderNo       String              @db.VarChar(40)
  supplierId    Int // → wms.TBLBUSINESSPARTNER (tedarikçi)
  warehouseId   Int // → wms.TBLWAREHOUSE (teslim deposu)
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  currency      String              @default("TRY") @db.VarChar(3)
  exchangeRate  Decimal             @default(1) @db.Decimal(18, 6)
  subTotal      Decimal             @default(0) @db.Decimal(18, 4)
  discountTotal Decimal             @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal             @default(0) @db.Decimal(18, 4)
  totalAmount   Decimal             @default(0) @db.Decimal(18, 4)
  note          String?             @db.VarChar(500)
  createdById   Int // → wms.TBLUSER
  approvedById  Int? // → wms.TBLUSER
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lines TBLPURCHASEORDERLINE[]

  @@unique([companyId, orderNo])
  @@index([companyId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@schema("procurement")
}

model TBLPURCHASEORDERLINE {
  id             Int      @id @default(autoincrement())
  orderId        Int
  lineNo         Int
  productId      Int // → wms.TBLPRODUCT
  unitId         Int // → wms.TBLUNIT
  quantity       Decimal  @db.Decimal(28, 8)
  receivedQty    Decimal  @default(0) @db.Decimal(28, 8)
  unitPrice      Decimal  @default(0) @db.Decimal(18, 4)
  discountRate   Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 4)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 4)
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order TBLPURCHASEORDER @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineNo])
  @@index([orderId])
  @@index([productId])
  @@schema("procurement")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED

  @@schema("procurement")
}

// ============================================================================
// SALES modülü — satış (schema: sales) — procurement'ın simetriği (OUTBOUND)
// wms'e GEVŞEK bağlı (id ile, cross-schema FK yok).
