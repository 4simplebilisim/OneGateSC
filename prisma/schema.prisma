generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["wms", "procurement", "sales", "logistics", "finance"]
}

// ----------------------------------------------------------------------------
// Tenant — çok-kiracılık kökü (legacy LNGDIST karşılığı, cari'den ayrıştırıldı)
// ----------------------------------------------------------------------------

model TBLCOMPANY {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(150)
  taxNumber String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses       TBLWAREHOUSE[]
  areas            TBLAREA[]
  locations        TBLLOCATION[]
  units            TBLUNIT[]
  products         TBLPRODUCT[]
  statuses         TBLSTATUS[]
  palletTypes      TBLPALLETTYPE[]
  pallets          TBLPALLET[]
  stocks           TBLSTOCK[]
  operationTypes   TBLOPERATIONTYPE[]
  documents        TBLDOCUMENT[]
  users            TBLUSER[]
  businessPartners TBLBUSINESSPARTNER[]
  inventoryRules   TBLINVENTORYRULE[]
  productGroups    TBLPRODUCTGROUP[]
  productTypes     TBLPRODUCTTYPE[]
  productDetailTypes TBLPRODUCTDETAILTYPE[]
  sequences        TBLSEQUENCE[]
  reasons          TBLREASON[]
  locationGroups   TBLLOCATIONGROUP[]
  operationGroups  TBLOPERATIONGROUP[]
  labelTypes          TBLLABELTYPE[]
  productSubGroups    TBLPRODUCTSUBGROUP[]
  workOrders          TBLWORKORDER[]
  entryConditionTypes TBLENTRYCONDITIONTYPE[]
  exitConditionTypes  TBLEXITCONDITIONTYPE[]
  routingTypes        TBLROUTINGTYPE[]
  routingRules        TBLROUTINGRULE[]
  facilities          TBLFACILITY[]
  regions             TBLREGION[]
  partnerGroups       TBLPARTNERGROUP[]
  locationCapacities  TBLLOCATIONCAPACITY[]
  barcodeTypes        TBLBARCODETYPE[]
  parameters          TBLPARAMETER[]
  printers            TBLPRINTER[]
  documentStatuses    TBLDOCUMENTSTATUS[]
  documentStatusActions   TBLDOCUMENTSTATUSACTION[]
  documentStatusCriteria  TBLDOCUMENTSTATUSCRITERIA[]
  documentApprovalTypes   TBLDOCUMENTAPPROVALTYPE[]

  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Auth — kullanıcı, rol, kullanıcı-rol bağlantısı (Faz 1'de global, tenant-bağımsız)
// ----------------------------------------------------------------------------

model TBLUSER {
  id           Int       @id @default(autoincrement())
  companyId    Int?
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(150)
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company   TBLCOMPANY?   @relation(fields: [companyId], references: [id])
  userRoles TBLUSERROLE[]
  documents TBLDOCUMENT[] @relation("DocumentCreatedBy")

  @@index([companyId])
  @@schema("wms")
}

model TBLROLE {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles TBLUSERROLE[]

  @@schema("wms")
}

model TBLUSERROLE {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())

  user TBLUSER @relation(fields: [userId], references: [id], onDelete: Cascade)
  role TBLROLE @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Depo / alan / lokasyon (legacy DEPO, ALAN, LOKASYON)
// ----------------------------------------------------------------------------

model TBLWAREHOUSE {
  id         Int      @id @default(autoincrement())
  companyId  Int
  facilityId Int? // tesis (bizim eklediğimiz — legacy'de yok)
  code       String   @db.VarChar(20)
  name       String   @db.VarChar(100)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company        TBLCOMPANY         @relation(fields: [companyId], references: [id])
  facility       TBLFACILITY?       @relation(fields: [facilityId], references: [id])
  areas          TBLAREA[]
  locations      TBLLOCATION[]
  documents      TBLDOCUMENT[]
  inventoryRules TBLINVENTORYRULE[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([facilityId])
  @@schema("wms")
}

model TBLAREA {
  id          Int      @id @default(autoincrement())
  companyId   Int
  warehouseId Int
  code        String   @db.VarChar(40)
  name        String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   TBLCOMPANY    @relation(fields: [companyId], references: [id])
  warehouse TBLWAREHOUSE  @relation(fields: [warehouseId], references: [id])
  locations TBLLOCATION[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([warehouseId])
  @@schema("wms")
}

model TBLLOCATION {
  id          Int            @id @default(autoincrement())
  companyId   Int
  warehouseId Int
  areaId      Int?
  parentId    Int?
  code        String         @db.VarChar(40)
  name        String?        @db.VarChar(100)
  type        LocationType   @default(SHELF)
  status      LocationStatus @default(ACTIVE)
  barcode     String?        @db.VarChar(60)
  isRamp      Boolean        @default(false)
  priority    Int?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company             TBLCOMPANY             @relation(fields: [companyId], references: [id])
  warehouse           TBLWAREHOUSE           @relation(fields: [warehouseId], references: [id])
  area                TBLAREA?               @relation(fields: [areaId], references: [id])
  parent              TBLLOCATION?           @relation("LocationTree", fields: [parentId], references: [id])
  children            TBLLOCATION[]          @relation("LocationTree")
  stocks              TBLSTOCK[]
  sourceDocumentLines TBLDOCUMENTLINE[]      @relation("LineSourceLocation")
  targetDocumentLines TBLDOCUMENTLINE[]      @relation("LineTargetLocation")
  groupLinks          TBLLOCATIONGROUPLINK[]

  @@unique([companyId, warehouseId, code])
  @@index([companyId])
  @@index([warehouseId])
  @@index([areaId])
  @@index([parentId])
  @@index([barcode])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Ürün / birim / ürün-birim çevrim (legacy URUN, BIRIM, URUNOLCUBIRIM)
// ----------------------------------------------------------------------------

model TBLUNIT {
  id            Int       @id @default(autoincrement())
  companyId     Int
  code          String    @db.VarChar(20)
  name          String    @db.VarChar(50)
  type          UnitType?
  referenceCode String?   @db.VarChar(50)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company            TBLCOMPANY        @relation(fields: [companyId], references: [id])
  products           TBLPRODUCT[]
  productUnits       TBLPRODUCTUNIT[]  @relation("ProductUnitMeasure")
  weightProductUnits TBLPRODUCTUNIT[]  @relation("ProductUnitWeight")
  pallets            TBLPALLET[]
  stocks             TBLSTOCK[]
  documentLines      TBLDOCUMENTLINE[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

model TBLPRODUCT {
  id                Int           @id @default(autoincrement())
  companyId         Int
  code              String        @db.VarChar(40)
  name              String        @db.VarChar(240)
  shortName         String?       @db.VarChar(50)
  productGroupCode  String?       @db.VarChar(20)
  productGroupId    Int?
  productSubGroupId Int?
  productTypeId     Int?
  detailTypeId      Int?
  manufacturerCode  String?       @db.VarChar(60)
  barcode           String?       @db.VarChar(50)
  gtin              String?       @db.VarChar(20)
  unitId            Int?
  vatRate           Decimal?      @db.Decimal(5, 2)
  weight            Decimal?      @db.Decimal(18, 4)
  volume            Decimal?      @db.Decimal(18, 4)
  type              ProductType   @default(STANDARD)
  status            ProductStatus @default(ACTIVE)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company         TBLCOMPANY              @relation(fields: [companyId], references: [id])
  unit            TBLUNIT?                @relation(fields: [unitId], references: [id])
  productGroup    TBLPRODUCTGROUP?        @relation(fields: [productGroupId], references: [id])
  productSubGroup TBLPRODUCTSUBGROUP?     @relation(fields: [productSubGroupId], references: [id])
  productType     TBLPRODUCTTYPE?         @relation(fields: [productTypeId], references: [id])
  detailType      TBLPRODUCTDETAILTYPE?   @relation(fields: [detailTypeId], references: [id])
  productUnits    TBLPRODUCTUNIT[]
  stocks          TBLSTOCK[]
  documentLines   TBLDOCUMENTLINE[]
  inventoryRules  TBLINVENTORYRULE[]
  substitutes     TBLPRODUCTSUBSTITUTE[]  @relation("ProductSubstituteMain")
  substituteOf    TBLPRODUCTSUBSTITUTE[]  @relation("ProductSubstituteSub")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([unitId])
  @@index([barcode])
  @@index([productGroupId])
  @@index([productSubGroupId])
  @@index([productTypeId])
  @@index([detailTypeId])
  @@schema("wms")
}

model TBLPRODUCTUNIT {
  id             Int      @id @default(autoincrement())
  productId      Int
  unitId         Int
  isBaseUnit     Boolean  @default(false)
  multiplier     Decimal  @default(1) @db.Decimal(28, 8)
  divisor        Decimal  @default(1) @db.Decimal(28, 8)
  barcode        String?  @db.VarChar(50)
  length         Decimal? @db.Decimal(18, 4)
  width          Decimal? @db.Decimal(18, 4)
  height         Decimal? @db.Decimal(18, 4)
  area           Decimal? @db.Decimal(18, 4)
  volume         Decimal? @db.Decimal(18, 4)
  netWeight      Decimal? @db.Decimal(18, 4)
  grossWeight    Decimal? @db.Decimal(18, 4)
  weightUnitId   Int?
  batchTracking  Boolean  @default(false)
  serialTracking Boolean  @default(false)
  minPalletQty   Decimal? @db.Decimal(28, 8)
  maxPalletQty   Decimal? @db.Decimal(28, 8)
  isSalesUnit    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    TBLPRODUCT              @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit       TBLUNIT                 @relation("ProductUnitMeasure", fields: [unitId], references: [id])
  weightUnit TBLUNIT?                @relation("ProductUnitWeight", fields: [weightUnitId], references: [id])
  barcodes   TBLPRODUCTUNITBARCODE[]

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@index([barcode])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Statü (legacy STATU) — stok statüsü, tablo-driven (firma-bazlı)
// ----------------------------------------------------------------------------

model TBLSTATUS {
  id        Int      @id @default(autoincrement())
  companyId Int
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             TBLCOMPANY        @relation(fields: [companyId], references: [id])
  stocks              TBLSTOCK[]
  sourceDocumentLines TBLDOCUMENTLINE[] @relation("LineSourceStatus")
  targetDocumentLines TBLDOCUMENTLINE[] @relation("LineTargetStatus")

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Palet tipi / palet (legacy PALETTIPI, PALET)
// ----------------------------------------------------------------------------

model TBLPALLETTYPE {
  id                   Int           @id @default(autoincrement())
  companyId            Int
  code                 String        @db.VarChar(20) // palet no öneki (prefix)
  name                 String        @db.VarChar(100)
  kind                 PalletKind? // bizim eklediğimiz fiziksel tür (EURO/INDUSTRIAL…) — opsiyonel
  mixingType           PalletMixing? // legacy BYTTIP — Tek Ürün Palet / Karma Palet
  facilityId           Int? // legacy LNGDISTKOD (Tesis)
  palletNoLength       Int? // LNGPALETNOUZUNLUK — palet no uzunluğu
  sequenceId           Int? // legacy LNGSAYACKOD — palet numarası bu sayaçtan
  isDivisible          Boolean       @default(true) // !BYTBOLUNEMEZ (Bölünebilir)
  partialUse           Boolean       @default(false) // BYTPARCALIKULLANIM — parçalı kullanım yapılsın
  batchControl         Boolean       @default(false) // BYTBATCHKONTROL
  singleProductControl Boolean       @default(false) // BYTTEKURUNKONTROLU — tek ürün kontrolü
  newNoOnEdit          Boolean       @default(false) // BYTDUZENLEMEDEYENINOALSIN
  // palet içi palet (üst/parçalı palet) + transfer davranışı
  breakParentPallet         Boolean  @default(false) // BYTUSTPALETBOZULSUN — üst palet bozulsun
  breakPartialPallet        Boolean  @default(false) // BYTPARCALIPALETBOZ — parçalı palet bozulsun
  breakPalletOnTransfer     Boolean  @default(false) // BYTTRANSFERDEPALETIBOZ
  removeFromPalletOnTransfer Boolean @default(false) // BYTTRANSFERDEPALETTENCIKAR
  keepFullPalletOnTransfer  Boolean  @default(false) // BYTTRANSFERTUMPALETKORU
  logging              Boolean       @default(false) // BYTLOGLAMA
  logControl           Boolean       @default(false) // BYTLOGKONTROL
  logControlWarningType Int? // BYTLOGKONTROLUYARITIPI
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company  TBLCOMPANY   @relation(fields: [companyId], references: [id])
  sequence TBLSEQUENCE? @relation(fields: [sequenceId], references: [id])
  pallets  TBLPALLET[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([sequenceId])
  @@schema("wms")
}

model TBLPALLET {
  id             Int       @id @default(autoincrement())
  companyId      Int
  palletNo       String    @db.VarChar(40)
  palletTypeId   Int
  parentPalletId Int?
  baseUnitId     Int?
  originalQty    Decimal?  @db.Decimal(28, 8)
  productionDate DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  beaconId       String?   @db.VarChar(200)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company       TBLCOMPANY        @relation(fields: [companyId], references: [id])
  palletType    TBLPALLETTYPE     @relation(fields: [palletTypeId], references: [id])
  parentPallet  TBLPALLET?        @relation("PalletNesting", fields: [parentPalletId], references: [id])
  childPallets  TBLPALLET[]       @relation("PalletNesting")
  baseUnit      TBLUNIT?          @relation(fields: [baseUnitId], references: [id])
  stocks        TBLSTOCK[]
  documentLines TBLDOCUMENTLINE[]

  @@unique([companyId, palletNo])
  @@index([companyId])
  @@index([palletTypeId])
  @@index([parentPalletId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Stok durumu (legacy STOKDURUM) — STOK KALBİ
// lokasyon × ürün × statü × batch × seri × palet kırılımı
// ----------------------------------------------------------------------------

model TBLSTOCK {
  id             Int       @id @default(autoincrement())
  companyId      Int
  locationId     Int
  productId      Int
  statusId       Int
  palletId       Int?
  batchNo        String?   @db.VarChar(100)
  serialNo       String?   @db.VarChar(100)
  customerId     Int? // cari Faz 2 — şimdilik soft ref (FK yok)
  poNo           String?   @db.VarChar(100)
  poLine         String?   @db.VarChar(100)
  mainQty        Decimal   @default(0) @db.Decimal(28, 8)
  reservedQty    Decimal   @default(0) @db.Decimal(28, 8)
  unitId         Int
  netWeight      Decimal?  @db.Decimal(28, 8)
  grossWeight    Decimal?  @db.Decimal(28, 8)
  productionDate DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  TBLCOMPANY  @relation(fields: [companyId], references: [id])
  location TBLLOCATION @relation(fields: [locationId], references: [id])
  product  TBLPRODUCT  @relation(fields: [productId], references: [id])
  status   TBLSTATUS   @relation(fields: [statusId], references: [id])
  pallet   TBLPALLET?  @relation(fields: [palletId], references: [id])
  unit     TBLUNIT     @relation(fields: [unitId], references: [id])

  @@unique([companyId, locationId, productId, statusId, batchNo, serialNo, palletId])
  @@index([companyId])
  @@index([locationId])
  @@index([productId])
  @@index([statusId])
  @@index([palletId])
  @@index([expiryDate])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Inventory — min/max stok seviyesi + reorder (MRP girdisi)
// ----------------------------------------------------------------------------

model TBLINVENTORYRULE {
  id           Int      @id @default(autoincrement())
  companyId    Int
  productId    Int
  warehouseId  Int
  minQty       Decimal  @default(0) @db.Decimal(28, 8)
  maxQty       Decimal  @default(0) @db.Decimal(28, 8)
  reorderPoint Decimal  @default(0) @db.Decimal(28, 8)
  reorderQty   Decimal  @default(0) @db.Decimal(28, 8)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   TBLCOMPANY   @relation(fields: [companyId], references: [id])
  product   TBLPRODUCT   @relation(fields: [productId], references: [id])
  warehouse TBLWAREHOUSE @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Cari — müşteri / tedarikçi (legacy MUSTERI/DIST'in iş-ortağı kısmı)
// ----------------------------------------------------------------------------

model TBLBUSINESSPARTNER {
  id             Int         @id @default(autoincrement())
  companyId      Int
  code           String      @db.VarChar(40)
  name           String      @db.VarChar(200)
  type           PartnerType @default(CUSTOMER)
  regionId       Int? // bölge (legacy TBLMSDBOLGE)
  partnerGroupId Int? // cari/müşteri grup (legacy TBLMUSTERIGRUP)
  parentId       Int? // zincir müşteri — üst cari (self-ref)
  taxNumber      String?     @db.VarChar(20)
  phone          String?     @db.VarChar(20)
  email          String?     @db.VarChar(150)
  city           String?     @db.VarChar(60)
  address        String?     @db.VarChar(255)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company      TBLCOMPANY           @relation(fields: [companyId], references: [id])
  region       TBLREGION?           @relation(fields: [regionId], references: [id])
  partnerGroup TBLPARTNERGROUP?     @relation(fields: [partnerGroupId], references: [id])
  parent       TBLBUSINESSPARTNER?  @relation("PartnerChain", fields: [parentId], references: [id])
  children     TBLBUSINESSPARTNER[] @relation("PartnerChain")
  documents    TBLDOCUMENT[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([regionId])
  @@index([partnerGroupId])
  @@index([parentId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Operasyon tipi (legacy OPERASYONTIPI) — belge davranışını sürer (yön + stok etkisi)
// ----------------------------------------------------------------------------

model TBLOPERATIONTYPE {
  id               Int               @id @default(autoincrement())
  companyId        Int
  code             String            @db.VarChar(20)
  name             String            @db.VarChar(100)
  direction        MovementDirection // legacy BYTKATEGORI (Giriş/Çıkış/Transfer/Sayım)
  facilityId       Int? // legacy LNGDISTKOD (Tesis)
  controlMode      ControlMode @default(UNCONTROLLED) // legacy BYTKONTROLLU (Kontrolsüz/Kontrollü/Referans Kontrollü)
  documentType     OperationDocumentType @default(STOCK_MOVEMENT) // legacy BYTBELGETIPI
  affectsStock     Boolean           @default(true)
  sequenceId       Int? // legacy LNGSAYACKOD — belge numarası bu sayaçtan
  operationSequenceId Int? // legacy LNGOPERASYONSAYACKOD
  groupSequenceId  Int? // legacy LNGGRUPSAYACKOD
  operationGroupId Int? // legacy LNGKONTROLGRUPKOD
  reverseOperationTypeId Int? // legacy LNGTERSOPERASYONKOD — ters/iptal operasyonu
  cancelLocationId Int? // legacy LNGIPTALLOKASYONKOD
  logControlDays   Int? // legacy LNGLOGKONTROLGUNSAYISI

  // Genel
  emailSend        Boolean @default(false) // BYTMAILGONDERILSIN
  // Stok Hareketi
  equivalentApplication Boolean @default(false) // BYTMUADILUYGULAMASI
  materialBasedCollection Boolean @default(false) // BYTMALBAZINDATOPLAMA
  materialBasedQtyEdit Boolean @default(false) // BYTMALBAZINDAMIKTARDUZENLENSIN
  batchAssignment  Boolean @default(false) // BYTBATCHATAMA
  qualityControl   Boolean @default(false) // BYTKLTKONTROLYAPILSIN
  detailLocationToCoverage Boolean @default(false) // BYTBELGEDETAYLOKASYONUKAPSAMAKTARILSIN
  // Entegrasyon
  integration      Boolean @default(false) // BYTPARAMENTEGRASYON
  approvedDocUpdate Boolean @default(false) // BYTONAYLIBELGEGUNCELLENSIN
  bulkSend         Boolean @default(false) // BYTTOPLUGONDERIM
  // Kontrol / İşlem
  readBasedControl Boolean @default(false) // BYTOKUTMABAZINDABILGILENDIRME
  readBasedInfoMessage Boolean @default(false) // BYTOKUTMABAZINDABILGIMESAJIGOSTER
  logging          Boolean @default(false) // BYTLOGLAMA
  logControl       Boolean @default(false) // BYTLOGKONTROL
  grouping         Boolean @default(false) // BYTGRUPLAMA
  reasonRequired   Boolean @default(false) // BYTNEDENGIRISZORUNLU
  reasonInHeader   Boolean @default(false) // BYTNEDENGIRISIBASLIKTA
  // Stok İşlemleri
  sameUsePallet    Boolean @default(false) // BYTAYNIPALETKULLANILSIN
  sameUseSerial    Boolean @default(false) // BYTAYNISERIKULLANILSIN
  passiveProductUse Boolean @default(false) // BYTPASIFURUNKULLANILSIN
  palletBreaking   Boolean @default(false) // BYTPALETBOZMA
  originalQtyUpdate Boolean @default(false) // BYTORJMIKGUNCELLENSIN
  reserveTransfer  Boolean @default(false) // BYTREZERVETRANSFEREDILSIN

  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company         TBLCOMPANY                   @relation(fields: [companyId], references: [id])
  sequence        TBLSEQUENCE?                 @relation(fields: [sequenceId], references: [id])
  operationGroup  TBLOPERATIONGROUP?           @relation(fields: [operationGroupId], references: [id])
  documents       TBLDOCUMENT[]
  statusLinks     TBLOPERATIONTYPESTATUS[]
  locationLinks   TBLOPERATIONTYPELOCATION[]
  reasonLinks     TBLOPERATIONTYPEREASON[]
  palletTypeLinks TBLOPERATIONTYPEPALLETTYPE[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([sequenceId])
  @@index([operationGroupId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Belge akışı — başlık + satır (kaynak→hedef hareket modeli)
// ----------------------------------------------------------------------------

model TBLDOCUMENT {
  id              Int            @id @default(autoincrement())
  companyId       Int
  documentNo      String         @db.VarChar(40)
  operationTypeId Int
  status          DocumentStatus @default(DRAFT) // iç yaşam döngüsü (motor): DRAFT/CONFIRMED/COMPLETED/CANCELLED
  documentStatusId Int? // kullanıcı-yüzlü Belge Durumu (Bekliyor→Toplanıyor→Onay Bekliyor→Onaylandı)
  warehouseId     Int
  createdById     Int
  partnerId       Int?
  reasonId        Int? // legacy LNGOPERASYONNEDENKOD
  documentDate    DateTime       @default(now())
  completedAt     DateTime?
  note            String?        @db.VarChar(500)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company        TBLCOMPANY         @relation(fields: [companyId], references: [id])
  operationType  TBLOPERATIONTYPE   @relation(fields: [operationTypeId], references: [id])
  documentStatus TBLDOCUMENTSTATUS? @relation(fields: [documentStatusId], references: [id])
  warehouse     TBLWAREHOUSE        @relation(fields: [warehouseId], references: [id])
  createdBy     TBLUSER             @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  partner       TBLBUSINESSPARTNER? @relation(fields: [partnerId], references: [id])
  reason        TBLREASON?          @relation(fields: [reasonId], references: [id])
  lines         TBLDOCUMENTLINE[]

  @@unique([companyId, documentNo])
  @@index([companyId])
  @@index([warehouseId])
  @@index([operationTypeId])
  @@index([partnerId])
  @@index([status])
  @@schema("wms")
}

model TBLDOCUMENTLINE {
  id               Int      @id @default(autoincrement())
  documentId       Int
  lineNo           Int
  productId        Int
  unitId           Int
  quantity         Decimal  @db.Decimal(28, 8)
  sourceLocationId Int?
  sourceStatusId   Int?
  targetLocationId Int?
  targetStatusId   Int?
  palletId         Int?
  batchNo          String?  @db.VarChar(100)
  serialNo         String?  @db.VarChar(100)
  note             String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  document       TBLDOCUMENT  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product        TBLPRODUCT   @relation(fields: [productId], references: [id])
  unit           TBLUNIT      @relation(fields: [unitId], references: [id])
  sourceLocation TBLLOCATION? @relation("LineSourceLocation", fields: [sourceLocationId], references: [id])
  targetLocation TBLLOCATION? @relation("LineTargetLocation", fields: [targetLocationId], references: [id])
  sourceStatus   TBLSTATUS?   @relation("LineSourceStatus", fields: [sourceStatusId], references: [id])
  targetStatus   TBLSTATUS?   @relation("LineTargetStatus", fields: [targetStatusId], references: [id])
  pallet         TBLPALLET?   @relation(fields: [palletId], references: [id])

  @@unique([documentId, lineNo])
  @@index([documentId])
  @@index([productId])
  @@index([sourceLocationId])
  @@index([targetLocationId])
  @@schema("wms")
}

