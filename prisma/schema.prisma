// ----------------------------------------------------------------------------
// Giriş/çıkış koşulu tipleri + yönlendirme (legacy GIRISKOSULTIPI/CIKISKOSULTIPI/
// YONLENDIRMETIPI + YONLENDIRMEURUNLOKASYONBAGLANTI) — directed putaway çekirdeği
// ----------------------------------------------------------------------------

// Giriş koşulu tipi (legacy TBLSBGIRISKOSULTIPI)
model TBLENTRYCONDITIONTYPE {
  id        Int      @id @default(autoincrement())
  companyId Int
  code      String   @db.VarChar(20)
  name      String?  @db.VarChar(100) // legacy TXTACIKLAMA
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    TBLCOMPANY                   @relation(fields: [companyId], references: [id])
  parameters TBLENTRYCONDITIONPARAMETER[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

// Çıkış koşulu tipi (legacy TBLSBCIKISKOSULTIPI)
model TBLEXITCONDITIONTYPE {
  id        Int      @id @default(autoincrement())
  companyId Int
  code      String   @db.VarChar(20)
  name      String?  @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    TBLCOMPANY                  @relation(fields: [companyId], references: [id])
  parameters TBLEXITCONDITIONPARAMETER[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

// Giriş/Çıkış koşulu kontrol tipi — SSP yerine yerleşik kontroller (legacy TXTSSP karşılığı)
enum ConditionControlType {
  MANUAL // her zaman gate — yalnızca kırma (şifre+neden) ile geçilir (denetçi onayı)
  REQUIRE_BATCH // satırda parti (lot) no zorunlu
  REQUIRE_SERIAL // satırda seri no zorunlu
  REQUIRE_REASON // belgede neden zorunlu
  CONTROL_FIELD_REQUIRED // çıkış: kontrol sahası (batchNo/serialNo/note) dolu olmalı
  MIN_SHELF_LIFE // çıkış: kalan raf ömrü >= dayCount gün (stok expiryDate)

  @@schema("wms")
}

// Giriş Koşulu Parametresi (legacy TBLSBGIRISKOSULPARAMETRE) — koşulun gerçek tanımı
model TBLENTRYCONDITIONPARAMETER {
  id                    Int                  @id @default(autoincrement())
  companyId             Int
  entryConditionTypeId  Int
  cariLinkType          LinkScope? // BYTCARIBAGLANTITIPI
  cariLinkId            Int? // LNGCARIBAGLANTIKODU
  materialLinkType      LinkScope? // BYTMALZEMEBAGLANTITIPI
  materialLinkId        Int? // LNGMALZEMEBAGLANTIKODU
  controlType           ConditionControlType @default(MANUAL)
  conditionBreakAllowed Boolean              @default(true) // BYTKOSULKIRMA
  exclude               Boolean              @default(false) // BYTHARIC
  sortOrder             Int? // LNGSIRA
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  entryConditionType TBLENTRYCONDITIONTYPE @relation(fields: [entryConditionTypeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entryConditionTypeId])
  @@schema("wms")
}

// Çıkış Koşulu Parametresi (legacy TBLSBCIKISKOSULPARAMETRE) — kontrol-sahası/tolerans/gün ek alanlarıyla
model TBLEXITCONDITIONPARAMETER {
  id                    Int                  @id @default(autoincrement())
  companyId             Int
  exitConditionTypeId   Int
  cariLinkType          LinkScope?
  cariLinkId            Int?
  materialLinkType      LinkScope?
  materialLinkId        Int?
  controlType           ConditionControlType @default(MANUAL)
  controlFieldId        Int? // LNGKONTROLSAHASI → TBLEXITCONDITIONCONTROLFIELD (ileride)
  toleranceValue        Decimal?             @db.Decimal(18, 4) // LNGTOLERANS
  percentValue          Decimal?             @db.Decimal(9, 4) // LNGYUZDEDEGER
  dayCount              Int? // LNGGUNSAYI (min raf ömrü vb. — ileride)
  conditionBreakAllowed Boolean              @default(true)
  exclude               Boolean              @default(false)
  sortOrder             Int?
