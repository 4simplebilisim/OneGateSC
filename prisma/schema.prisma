  name      String   @db.VarChar(60)
  colorCode String?  @db.VarChar(100) // TXTRENKKODU
  reference String?  @db.VarChar(200) // TXTREFERANS
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links TBLPARTNEREXTRAGROUPLINK[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

// Cari ↔ Ek Grup bağlantı (legacy TBLSBMUSTERIEKGRUPBAGLANTI)
model TBLPARTNEREXTRAGROUPLINK {
  id           Int      @id @default(autoincrement())
  companyId    Int
  partnerId    Int
  extraGroupId Int
  sortOrder    Int? // LNGSIRANO
  createdAt    DateTime @default(now())

  partner    TBLBUSINESSPARTNER   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  extraGroup TBLPARTNEREXTRAGROUP @relation(fields: [extraGroupId], references: [id])

  @@unique([partnerId, extraGroupId])
  @@index([companyId])
  @@index([partnerId])
  @@index([extraGroupId])
  @@schema("wms")
}

// Müşteri Ek Saha tanımı — master (ek saha slotları)
model TBLPARTNEREXTRAFIELDDEF {
