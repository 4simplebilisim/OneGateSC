// ============================================================================
// PROCUREMENT modülü — satınalma (schema: procurement)
// wms'e GEVŞEK bağlı: wms entity'leri id ile referanslanır (cross-schema FK yok),
// referans bütünlüğü uygulama katmanında doğrulanır. Modüller ayrı kalır.
// ============================================================================

model TBLPURCHASEORDER {
  id            Int                 @id @default(autoincrement())
  companyId     Int
  orderNo       String              @db.VarChar(40)
  supplierId    Int // → wms.TBLBUSINESSPARTNER (tedarikçi)
  warehouseId   Int // → wms.TBLWAREHOUSE (teslim deposu)
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  currency      String              @default("TRY") @db.VarChar(3)
  exchangeRate  Decimal             @default(1) @db.Decimal(18, 6)
  subTotal      Decimal             @default(0) @db.Decimal(18, 4)
  discountTotal Decimal             @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal             @default(0) @db.Decimal(18, 4)
  totalAmount   Decimal             @default(0) @db.Decimal(18, 4)
  note          String?             @db.VarChar(500)
  createdById   Int // → wms.TBLUSER
  approvedById  Int? // → wms.TBLUSER
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lines TBLPURCHASEORDERLINE[]

  @@unique([companyId, orderNo])
  @@index([companyId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@schema("procurement")
}

model TBLPURCHASEORDERLINE {
  id             Int      @id @default(autoincrement())
  companyId Int // tenant (cok-kiracilik) - parent kaydin companyId siyle ayni
  orderId        Int
  lineNo         Int
  productId      Int // → wms.TBLPRODUCT
  unitId         Int // → wms.TBLUNIT
  quantity       Decimal  @db.Decimal(28, 8)
  receivedQty    Decimal  @default(0) @db.Decimal(28, 8)
  unitPrice      Decimal  @default(0) @db.Decimal(18, 4)
