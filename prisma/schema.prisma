  queryDetail     String?  @db.Text // TXTSORGUDETAY (SQL)
  bindingField    String?  @db.VarChar(80) // TXTBAGLANTISAHA
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template TBLLABELTEMPLATE @relation(fields: [labelTemplateId], references: [id])

  @@index([companyId])
  @@index([labelTemplateId])
  @@schema("wms")
}
