  note        String?  @db.VarChar(200)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([documentId])
  @@index([userId])
  @@index([userGroupId])
  @@schema("wms")
}

// Operasyon Tipi Saha Bağlantı — legacy TBLSBPPCGORUNTULENECEKSAHALAR (LNGOPERASYONTIPI + LNGSAHAKOD)
model TBLOPERATIONTYPEEXTRAFIELD {
