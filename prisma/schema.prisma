// ============================================================================
// FINANCE modülü — fatura/muhasebe (schema: finance)
// PO/SO'dan fatura üretir; wms cari'ye gevşek bağlı.
// ============================================================================

model TBLINVOICE {
  id              Int            @id @default(autoincrement())
  companyId       Int
  invoiceNo       String         @db.VarChar(40)
  type            InvoiceType
  partnerId       Int // → wms.TBLBUSINESSPARTNER
  sourceOrderType InvoiceSource?
  sourceOrderId   Int?
  status          InvoiceStatus  @default(DRAFT)
  invoiceDate     DateTime       @default(now())
  dueDate         DateTime?
  currency        String         @default("TRY") @db.VarChar(3)
  exchangeRate    Decimal        @default(1) @db.Decimal(18, 6)
  subTotal        Decimal        @default(0) @db.Decimal(18, 4)
  discountTotal   Decimal        @default(0) @db.Decimal(18, 4)
  taxTotal        Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal        @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal        @default(0) @db.Decimal(18, 4)
  note            String?        @db.VarChar(500)
  createdById     Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines TBLINVOICELINE[]

  @@unique([companyId, invoiceNo])
  @@index([companyId])
  @@index([partnerId])
  @@index([status])
  @@schema("finance")
}

model TBLINVOICELINE {
  id             Int      @id @default(autoincrement())
  companyId Int // tenant (cok-kiracilik) - parent kaydin companyId siyle ayni
  invoiceId      Int
  lineNo         Int
  productId      Int
  unitId         Int
  quantity       Decimal  @db.Decimal(28, 8)
  unitPrice      Decimal  @default(0) @db.Decimal(18, 4)
  discountRate   Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 4)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 4)
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice TBLINVOICE @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@index([invoiceId])
  @@index([companyId])
  @@schema("finance")
}

enum InvoiceType {
  PURCHASE
  SALES

  @@schema("finance")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED

  @@schema("finance")
}

enum InvoiceSource {
  PURCHASE_ORDER
  SALES_ORDER

  @@schema("finance")
}

// ── Ek Saha (custom field) — legacy TBLEKSAHATANIMLAMA (Dinamik) + TBLSBSTATIKSAHATANIMLAMA (Statik) TEK tabloda birleşik.
// fieldKind ayırt-edici (Dinamik/Statik). "Tesis" = firma (BYTFIRMA/TXTDIST/LNGDISTKOD) = companyId (örtük).
enum ExtraFieldKind {
  DYNAMIC // Dinamik
  STATIC // Statik

  @@schema("wms")
}

// BYTTIP — sahanın uygulanacağı varlık (StokBar "Tip" dropdown'ı)
enum ExtraFieldEntity {
  MATERIAL // Malzeme
  PARTNER // Cari
  DOC_HEADER // Belge Başlık
  DOC_DETAIL // Belge Detay
  DOC_SCOPE // Belge Kapsam
  PALLET // Palet
  STOCK // Stok
  PALLET_NOTIFY_HEADER // Palet Bildirim Başlık
  OPERATION_DOC_DETAIL // Operasyon Belge Detay

  @@schema("wms")
}

// BYTEKSAHAOZELLIK — sahanın veri tipi (StokBar "Ek Saha Özelliği")
enum ExtraFieldDataType {
  MULTI_SELECT_FIXED // Çoktan Seçmeli Sabit
  TEXT // Metin
  NUMERIC // Sayısal
  DATE // Tarih
  LOOKUP // Rehber

  @@schema("wms")
}

// Ek Saha tanımı (Dinamik + Statik birleşik)
model TBLEXTRAFIELD {
  id                 Int                @id @default(autoincrement())
  companyId          Int
  facilityId         Int? // tesis (opsiyonel — boş=tüm tesisler). Tenant'ın birden çok tesisi olabilir; ek saha tesise göre tanımlanabilir.
  fieldKind          ExtraFieldKind     @default(DYNAMIC) // Dinamik/Statik
  entityType         ExtraFieldEntity // BYTTIP — uygulama yeri
  trackingCode       String?            @db.VarChar(40) // LNGTAKIPKOD
  description        String             @db.VarChar(200) // TXTACIKLAMA (zorunlu)
  fieldDataType      ExtraFieldDataType // BYTEKSAHAOZELLIK
  defaultValue       String?            @db.VarChar(200) // TXTDEFAULTDEGER
  maxAnswerCount     Int? // BYTMAXCEVAP
  isRequired         Boolean            @default(false) // BYTZORUNLU
  minLength          Int? // LNGMINIMUMUZUNLUK (dinamik)
  maxLength          Int? // LNGMAXIMUMUZUNLUK (dinamik)
  useAsIncrementing  Boolean            @default(false) // BYTURUNBAZINDAARTANDEGER
  transferOnDocSplit Boolean            @default(false) // BYTBOLMEISLEMINDEAKTAR
  reference          String?            @db.VarChar(200) // TXTREFERANS
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  options TBLEXTRAFIELDOPTION[]

  @@index([companyId])
  @@index([facilityId])
  @@schema("wms")
}

// Ek Saha seçenekleri (Çoktan Seçmeli / Rehber için) — legacy TBLEKSAHASECENEK
model TBLEXTRAFIELDOPTION {
  id           Int      @id @default(autoincrement())
  companyId    Int
  extraFieldId Int // LNGTAKIPKOD
  code         String   @db.VarChar(40) // LNGKOD
  description  String?  @db.VarChar(200) // TXTACIKLAMA
  sortOrder    Int?
  reference    String?  @db.VarChar(200) // TXTREFERANS
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  extraField TBLEXTRAFIELD @relation(fields: [extraFieldId], references: [id])

  @@index([companyId])
  @@index([extraFieldId])
  @@schema("wms")
}

// İş Atama — belge ↔ kullanıcı eşleştirme. Terminalde kullanıcıya atanmış belgeler gözükür.
