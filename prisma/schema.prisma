  countedQty Decimal? @db.Decimal(28, 8)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  count TBLSTOCKCOUNT @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, lineNo])
  @@index([countId])
  @@index([productId])
  @@index([companyId])
  @@schema("wms")
}

enum CountStatus {
  DRAFT
  COUNTING
  COMPLETED
  CANCELLED

  @@schema("wms")
}

