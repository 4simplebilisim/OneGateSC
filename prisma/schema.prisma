// Etiket Tipi Item — form alanları (TBLSBDEETIKETTIPIITEM çekirdek alanlar)
model TBLLABELTEMPLATEITEM {
  id              Int      @id @default(autoincrement())
  companyId       Int
  labelTemplateId Int // LNGETIKETTIPKOD
  title           String?  @db.VarChar(120) // TXTBASLIK
  itemType        String?  @db.VarChar(20) // BYTTIP (TEXT/NUMBER/DATE/COMBO/LOOKUP/CHECKBOX/BARCODE/LABEL)
  designName      String?  @db.VarChar(80) // TXTDIZAYNISIM
  displayName     String?  @db.VarChar(120) // TXTGORUNUMISIM
  sortOrder       Int? // LNGGORUNUMSIRA
  isRequired      Boolean  @default(false) // BYTZORUNLU
  isVisible       Boolean  @default(true) // BYTGORUNUR
  width           Int? // LNGGENISLIK
  maxLength       Int? // LNGMAXUZUNLUK
  defaultValue    String?  @db.VarChar(200) // TXTCHARDEFAULTDEGER
  comboQuery      String?  @db.Text // TXTCOMBOSORGU (combo veri sorgusu)
  lookupId        Int? // LNGREHBERKOD
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template TBLLABELTEMPLATE @relation(fields: [labelTemplateId], references: [id])

  @@index([companyId])
  @@index([labelTemplateId])
  @@schema("wms")
}

// Etiket Tipi Sorgu — sorgu kütüphanesi (TBLSBDEETIKETTIPISORGU)
model TBLLABELTEMPLATEQUERY {
  id              Int      @id @default(autoincrement())
