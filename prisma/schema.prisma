generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["wms", "procurement", "sales", "logistics", "finance"]
}

// ----------------------------------------------------------------------------
// Tenant — çok-kiracılık kökü (legacy LNGDIST karşılığı, cari'den ayrıştırıldı)
// ----------------------------------------------------------------------------

model TBLCOMPANY {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses       TBLWAREHOUSE[]
  areas            TBLAREA[]
  locations        TBLLOCATION[]
  units            TBLUNIT[]
  products         TBLPRODUCT[]
  statuses         TBLSTATUS[]
  palletTypes      TBLPALLETTYPE[]
  pallets          TBLPALLET[]
  stocks           TBLSTOCK[]
  operationTypes   TBLOPERATIONTYPE[]
  documents        TBLDOCUMENT[]
  users            TBLUSER[]
  businessPartners TBLBUSINESSPARTNER[]
  inventoryRules   TBLINVENTORYRULE[]
  productGroups    TBLPRODUCTGROUP[]
  productTypes     TBLPRODUCTTYPE[]
  productDetailTypes TBLPRODUCTDETAILTYPE[]
  sequences        TBLSEQUENCE[]
  reasons          TBLREASON[]
  locationGroups   TBLLOCATIONGROUP[]
  operationGroups  TBLOPERATIONGROUP[]
  labelTypes          TBLLABELTYPE[]
  productSubGroups    TBLPRODUCTSUBGROUP[]
  workOrders          TBLWORKORDER[]
  entryConditionTypes TBLENTRYCONDITIONTYPE[]
  exitConditionTypes  TBLEXITCONDITIONTYPE[]
  routingTypes        TBLROUTINGTYPE[]
  routingRules        TBLROUTINGRULE[]
  facilities          TBLFACILITY[]
  regions             TBLREGION[]
  partnerGroups       TBLPARTNERGROUP[]
  locationCapacities  TBLLOCATIONCAPACITY[]
  barcodeTypes        TBLBARCODETYPE[]
  parameters          TBLPARAMETER[]
  printers            TBLPRINTER[]
  documentStatuses    TBLDOCUMENTSTATUS[]
  documentStatusActions   TBLDOCUMENTSTATUSACTION[]
  documentStatusCriteria  TBLDOCUMENTSTATUSCRITERIA[]
  documentApprovalTypes   TBLDOCUMENTAPPROVALTYPE[]
  userAuthorizations      TBLUSERAUTHORIZATION[]
  userGroups              TBLUSERGROUP[]
  userColumnAuths         TBLUSERCOLUMNAUTH[]
  userScreenRights        TBLUSERSCREENRIGHT[]

  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Auth — kullanıcı, rol, kullanıcı-rol bağlantısı (Faz 1'de global, tenant-bağımsız)
// ----------------------------------------------------------------------------

model TBLUSER {
  id           Int       @id @default(autoincrement())
  companyId    Int?
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(150)
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  lastLoginAt  DateTime?
  // StokBar Kullanıcı kartı alanları (B)
  userType             String?   @db.VarChar(20) // Tip: CENTRAL (Merkez) / BRANCH (Şube)
  isApproved           Boolean   @default(true) // Onay durumu
  phone                String?   @db.VarChar(30) // Cep Tel No
  validUntil           DateTime? @db.Date // Geçerlilik Tarihi
  alias                String?   @db.VarChar(60)
  passwordNeverExpires Boolean   @default(true) // Şifre her zaman geçerli olsun
  mustChangePassword   Boolean   @default(false) // Sonraki oturumda şifre değiştir
  cannotChangePassword Boolean   @default(false) // Şifreyi değiştiremez
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company          TBLCOMPANY?            @relation(fields: [companyId], references: [id])
  userRoles        TBLUSERROLE[]
  authorizations   TBLUSERAUTHORIZATION[]
  groupMemberships TBLUSERGROUPMEMBER[]
  columnAuths      TBLUSERCOLUMNAUTH[]
  screenRights     TBLUSERSCREENRIGHT[]
  documents        TBLDOCUMENT[]          @relation("DocumentCreatedBy")

  @@index([companyId])
  @@schema("wms")
}

model TBLROLE {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles TBLUSERROLE[]

  @@schema("wms")
}

model TBLUSERROLE {
  userId     Int
  roleId     Int
  companyId  Int? // tenant (çok-kiracılık) — kullanıcının companyId'siyle aynı (super-admin'de null olabilir)
  assignedAt DateTime @default(now())

  user TBLUSER @relation(fields: [userId], references: [id], onDelete: Cascade)
  role TBLROLE @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([companyId])
  @@schema("wms")
}

// Kullanıcı yetkisi: hangi tesis/depo/operasyon tipine erişebilir (legacy TBLKULLANICIYETKIDETAY mantığı, temiz).
// Bir scope tipinde HİÇ kayıt yoksa o boyut serbest (kısıtlama-listesi modeli); kayıt varsa yalnız listedekiler.
model TBLUSERAUTHORIZATION {
  id            Int           @id @default(autoincrement())
  companyId     Int
  userId        Int? // sahip = kullanıcı (doğrudan) — VEYA groupId (gruptan miras)
  groupId       Int? // sahip = kullanıcı grubu
  scopeType     UserScopeType
  referenceId   Int? // entity scope (FACILITY/WAREHOUSE/OPERATION_TYPE) → ilgili tablo id'si
  referenceCode String?       @db.VarChar(60) // SCREEN scope → ekran/menü anahtarı (resource adı)
  deny          Boolean       @default(false) // KULLANICI > GRUP: kullanıcı seviyesinde bir yetkiyi YASAKLA (grubun verdiğini kaldırır). grant=izin, deny=yasak
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company TBLCOMPANY    @relation(fields: [companyId], references: [id])
  user    TBLUSER?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   TBLUSERGROUP? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, referenceId])
  @@unique([userId, scopeType, referenceCode])
  @@unique([groupId, scopeType, referenceId])
  @@unique([groupId, scopeType, referenceCode])
  @@index([companyId])
  @@index([userId])
  @@index([groupId])
  @@schema("wms")
}

enum UserScopeType {
  COMPANY // firma (tenant) erişimi — kullanıcı birden fazla firmada işlem yapabilir (referenceId = companyId)
  FACILITY
  WAREHOUSE
  OPERATION_TYPE
  SCREEN // ekran/menü erişimi (referenceCode = resource adı)

  @@schema("wms")
}

// Kullanıcı grubu — gruba verilen yetkiler üyelerine miras geçer (legacy TBLKULLANICIGRUP).
model TBLUSERGROUP {
  id        Int      @id @default(autoincrement())
  companyId Int
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        TBLCOMPANY             @relation(fields: [companyId], references: [id])
  members        TBLUSERGROUPMEMBER[]
  authorizations TBLUSERAUTHORIZATION[]
  columnAuths    TBLUSERCOLUMNAUTH[]
  screenRights   TBLUSERSCREENRIGHT[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

model TBLUSERGROUPMEMBER {
  userId    Int
  groupId   Int
  companyId Int? // tenant (çok-kiracılık) — kullanıcının companyId'siyle aynı (super-admin'de null olabilir)

  user  TBLUSER      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group TBLUSERGROUP @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@index([companyId])
  @@schema("wms")
}

// Kolon (alan) yetkisi: kullanıcı/grup × ekran(resource) × alan → mod. Kayıt yoksa = görünür+düzenlenebilir (varsayılan).
model TBLUSERCOLUMNAUTH {
  id        Int           @id @default(autoincrement())
  companyId Int
  userId    Int?
  groupId   Int?
  resource  String        @db.VarChar(60) // ekran (resource adı)
  column    String        @db.VarChar(60) // alan adı (formConfig field)
  mode      ColumnAuthMode // READONLY (salt-okunur) | HIDDEN (gizli)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company TBLCOMPANY    @relation(fields: [companyId], references: [id])
  user    TBLUSER?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   TBLUSERGROUP? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, column])
  @@unique([groupId, resource, column])
  @@index([companyId])
  @@index([userId])
  @@index([groupId])
  @@schema("wms")
}

enum ColumnAuthMode {
  READONLY
  HIDDEN

  @@schema("wms")
}

// Ekran hakkı (aksiyon matrisi): kullanıcı/grup × ekran(resource) → İzle/Yeni/Düzenle/Sil.
// Kayıt YOKSA tüm aksiyonlar serbest (kısıtlama-listesi). Grup birleşiminde en kısıtlayıcı geçer (false öncelikli).
model TBLUSERSCREENRIGHT {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int?
  groupId   Int?
  resource  String   @db.VarChar(60)
  canView   Boolean  @default(true) // İzle (görünür)
  canAdd    Boolean  @default(true) // Yeni
  canEdit   Boolean  @default(true) // Düzenle
  canDelete Boolean  @default(true) // Sil
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company TBLCOMPANY    @relation(fields: [companyId], references: [id])
  user    TBLUSER?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   TBLUSERGROUP? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
  @@unique([groupId, resource])
  @@index([companyId])
  @@index([userId])
  @@index([groupId])
  @@schema("wms")
}

// El terminali (Android) DİNAMİK menü — Tesis bazlı grup + menü item (operasyon koduna bağlı).
// StokBar "El Terminali Uyarlama": menü adı/parametre/operasyon kodu dinamik. companyId/facilityId/operationTypeId düz Int (relation yok).
model TBLHANDHELDMENUGROUP {
  id         Int      @id @default(autoincrement())
  companyId  Int
  facilityId Int? // Tesis (null = tüm tesisler)
  code       String   @db.VarChar(40)
  name       String   @db.VarChar(100)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items TBLHANDHELDMENUITEM[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

model TBLHANDHELDMENUITEM {
  id              Int                @id @default(autoincrement())
  companyId       Int
  groupId         Int
  code            String             @db.VarChar(40)
  name            String             @db.VarChar(100)
  screenType      HandheldScreenType // hangi mobil akış (mal kabul/toplama/sayım/stok)
  operationTypeId Int? // ön-seçili operasyon tipi (operasyon kodu, ZG01 vb.)
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  group TBLHANDHELDMENUGROUP @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@index([groupId])
  @@schema("wms")
}

enum HandheldScreenType {
  RECEIPT // Mal Kabul
  PICK // Toplama
  COUNT // Sayım
  STOCK // Stok Sorgu

  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Depo / alan / lokasyon (legacy DEPO, ALAN, LOKASYON)
// ----------------------------------------------------------------------------

model TBLWAREHOUSE {
  id         Int      @id @default(autoincrement())
  companyId  Int
  facilityId Int? // tesis (bizim eklediğimiz — legacy'de yok)
  code       String   @db.VarChar(20)
  name       String   @db.VarChar(100)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company        TBLCOMPANY         @relation(fields: [companyId], references: [id])
  facility       TBLFACILITY?       @relation(fields: [facilityId], references: [id])
  areas          TBLAREA[]
  locations      TBLLOCATION[]
  documents      TBLDOCUMENT[]
  inventoryRules TBLINVENTORYRULE[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([facilityId])
  @@schema("wms")
}

model TBLAREA {
  id          Int      @id @default(autoincrement())
  companyId   Int
  facilityId  Int? // Tesis — depodan türetilir (depo bir tesise ait); firma>tesis>depo>alan hiyerarşisi
  warehouseId Int
  code        String   @db.VarChar(40)
  name        String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   TBLCOMPANY    @relation(fields: [companyId], references: [id])
  facility  TBLFACILITY?  @relation(fields: [facilityId], references: [id])
  warehouse TBLWAREHOUSE  @relation(fields: [warehouseId], references: [id])
  locations TBLLOCATION[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([facilityId])
  @@index([warehouseId])
  @@schema("wms")
}

model TBLLOCATION {
  id          Int            @id @default(autoincrement())
  companyId   Int
  facilityId  Int? // Tesis — depodan türetilir (firma>tesis>depo>alan>lokasyon hiyerarşisi)
  warehouseId Int
  areaId      Int?
  parentId    Int?
  code        String         @db.VarChar(40)
  name        String?        @db.VarChar(100)
  type        LocationType   @default(SHELF)
  status      LocationStatus @default(ACTIVE)
  barcode     String?        @db.VarChar(60)
  isRamp      Boolean        @default(false)
  priority    Int?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company             TBLCOMPANY             @relation(fields: [companyId], references: [id])
  facility            TBLFACILITY?           @relation(fields: [facilityId], references: [id])
  warehouse           TBLWAREHOUSE           @relation(fields: [warehouseId], references: [id])
  area                TBLAREA?               @relation(fields: [areaId], references: [id])
  parent              TBLLOCATION?           @relation("LocationTree", fields: [parentId], references: [id])
  children            TBLLOCATION[]          @relation("LocationTree")
  stocks              TBLSTOCK[]
  sourceDocumentLines TBLDOCUMENTLINE[]      @relation("LineSourceLocation")
  targetDocumentLines TBLDOCUMENTLINE[]      @relation("LineTargetLocation")
  groupLinks          TBLLOCATIONGROUPLINK[]

  @@unique([companyId, warehouseId, code])
  @@index([companyId])
  @@index([facilityId])
  @@index([warehouseId])
  @@index([areaId])
  @@index([parentId])
  @@index([barcode])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Ürün / birim / ürün-birim çevrim (legacy URUN, BIRIM, URUNOLCUBIRIM)
// ----------------------------------------------------------------------------

model TBLUNIT {
  id            Int       @id @default(autoincrement())
  companyId     Int
  code          String    @db.VarChar(20)
  name          String    @db.VarChar(50)
  type          UnitType?
  referenceCode String?   @db.VarChar(50)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company            TBLCOMPANY        @relation(fields: [companyId], references: [id])
  products           TBLPRODUCT[]
  productUnits       TBLPRODUCTUNIT[]  @relation("ProductUnitMeasure")
  weightProductUnits TBLPRODUCTUNIT[]  @relation("ProductUnitWeight")
  pallets            TBLPALLET[]
  stocks             TBLSTOCK[]
  documentLines      TBLDOCUMENTLINE[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("wms")
}

model TBLPRODUCT {
  id                Int           @id @default(autoincrement())
  companyId         Int
  code              String        @db.VarChar(40)
  name              String        @db.VarChar(240)
  shortName         String?       @db.VarChar(50)
  productGroupCode  String?       @db.VarChar(20)
  productGroupId    Int?
  productSubGroupId Int?
  productTypeId     Int?
  detailTypeId      Int?
  manufacturerCode  String?       @db.VarChar(60)
  barcode           String?       @db.VarChar(50)
  gtin              String?       @db.VarChar(20)
  unitId            Int?
  vatRate           Decimal?      @db.Decimal(5, 2)
  weight            Decimal?      @db.Decimal(18, 4)
  volume            Decimal?      @db.Decimal(18, 4)
  // Raf ömrü (legacy TBLURUN.BYTRAFOMRU / LNGRAFOMRUDEGER) — açıksa girişte expiryDate = +shelfLifeDays
  shelfLifeControl  Boolean       @default(false)
  shelfLifeDays     Int?
  // Değişken ağırlık / catch-weight (legacy DBLMIN/MAXAGIRLIK) — et/gıda; hareket ağırlığı bandı
  catchWeight       Boolean       @default(false)
  minWeight         Decimal?      @db.Decimal(18, 4)
  maxWeight         Decimal?      @db.Decimal(18, 4)
  type              ProductType   @default(STANDARD)
  status            ProductStatus @default(ACTIVE)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company         TBLCOMPANY              @relation(fields: [companyId], references: [id])
  unit            TBLUNIT?                @relation(fields: [unitId], references: [id])
  productGroup    TBLPRODUCTGROUP?        @relation(fields: [productGroupId], references: [id])
  productSubGroup TBLPRODUCTSUBGROUP?     @relation(fields: [productSubGroupId], references: [id])
  productType     TBLPRODUCTTYPE?         @relation(fields: [productTypeId], references: [id])
  detailType      TBLPRODUCTDETAILTYPE?   @relation(fields: [detailTypeId], references: [id])
  productUnits    TBLPRODUCTUNIT[]
  stocks          TBLSTOCK[]
  documentLines   TBLDOCUMENTLINE[]
  inventoryRules  TBLINVENTORYRULE[]
  substitutes     TBLPRODUCTSUBSTITUTE[]  @relation("ProductSubstituteMain")
  substituteOf    TBLPRODUCTSUBSTITUTE[]  @relation("ProductSubstituteSub")
  facilities      TBLPRODUCTFACILITY[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([unitId])
  @@index([barcode])
  @@index([productGroupId])
  @@index([productSubGroupId])
  @@index([productTypeId])
  @@index([detailTypeId])
  @@schema("wms")
}

// Ürün ↔ kullanılabilir tesis (kısıtlama-listesi): kayıt yoksa ürün TÜM tesislerde kullanılabilir; kayıt varsa yalnız listedekiler.
// Belge oluştururken deponun tesisi ürünün izinli tesisleri içinde olmalı (movement/documents enforcement).
model TBLPRODUCTFACILITY {
  id         Int      @id @default(autoincrement())
  companyId  Int
  productId  Int
  facilityId Int
  createdAt  DateTime @default(now())

  product TBLPRODUCT @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, facilityId])
  @@index([companyId])
  @@index([productId])
  @@schema("wms")
}

model TBLPRODUCTUNIT {
  id             Int      @id @default(autoincrement())
  companyId Int // tenant (cok-kiracilik) - parent kaydin companyId siyle ayni
  productId      Int
  unitId         Int
  isBaseUnit     Boolean  @default(false)
  multiplier     Decimal  @default(1) @db.Decimal(28, 8)
  divisor        Decimal  @default(1) @db.Decimal(28, 8)
  barcode        String?  @db.VarChar(50)
  length         Decimal? @db.Decimal(18, 4)
  width          Decimal? @db.Decimal(18, 4)
  height         Decimal? @db.Decimal(18, 4)
  area           Decimal? @db.Decimal(18, 4)
  volume         Decimal? @db.Decimal(18, 4)
  netWeight      Decimal? @db.Decimal(18, 4)
  grossWeight    Decimal? @db.Decimal(18, 4)
  weightUnitId   Int?
  batchTracking  Boolean  @default(false)
  serialTracking Boolean  @default(false)
  minPalletQty   Decimal? @db.Decimal(28, 8)
  maxPalletQty   Decimal? @db.Decimal(28, 8)
  isSalesUnit    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    TBLPRODUCT              @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit       TBLUNIT                 @relation("ProductUnitMeasure", fields: [unitId], references: [id])
  weightUnit TBLUNIT?                @relation("ProductUnitWeight", fields: [weightUnitId], references: [id])
  barcodes   TBLPRODUCTUNITBARCODE[]

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@index([barcode])
  @@index([companyId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Statü (legacy STATU) — stok statüsü, tablo-driven (firma-bazlı)
// ----------------------------------------------------------------------------

model TBLSTATUS {
  id         Int      @id @default(autoincrement())
  companyId  Int // tenant (çok-kiracılık) — TBLCOMPANY. Legacy LNGDISTKOD=tesis'ten AYRI boyut (LNGTENANTID karşılığı).
  facilityId Int // tesis — statü TAM OLARAK tek tesise aittir (legacy LNGDISTKOD karşılığı).
  code       String   @db.VarChar(20)
  name       String   @db.VarChar(100)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company             TBLCOMPANY        @relation(fields: [companyId], references: [id])
  facility            TBLFACILITY       @relation(fields: [facilityId], references: [id])
  stocks              TBLSTOCK[]
  sourceDocumentLines TBLDOCUMENTLINE[] @relation("LineSourceStatus")
  targetDocumentLines TBLDOCUMENTLINE[] @relation("LineTargetStatus")

  @@unique([companyId, facilityId, code]) // kod TESİS+firma bazında benzersiz — aynı kod farklı tesiste serbest
  @@index([companyId])
  @@index([facilityId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Palet tipi / palet (legacy PALETTIPI, PALET)
// ----------------------------------------------------------------------------

model TBLPALLETTYPE {
  id                   Int           @id @default(autoincrement())
  companyId            Int
  code                 String        @db.VarChar(20) // palet no öneki (prefix)
  name                 String        @db.VarChar(100)
  kind                 PalletKind? // bizim eklediğimiz fiziksel tür (EURO/INDUSTRIAL…) — opsiyonel
  mixingType           PalletMixing? // legacy BYTTIP — Tek Ürün Palet / Karma Palet
  facilityId           Int? // legacy LNGDISTKOD (Tesis)
  palletNoLength       Int? // LNGPALETNOUZUNLUK — palet no uzunluğu
  sequenceId           Int? // legacy LNGSAYACKOD — palet numarası bu sayaçtan
  isDivisible          Boolean       @default(true) // !BYTBOLUNEMEZ (Bölünebilir)
  partialUse           Boolean       @default(false) // BYTPARCALIKULLANIM — parçalı kullanım yapılsın
  batchControl         Boolean       @default(false) // BYTBATCHKONTROL
  singleProductControl Boolean       @default(false) // BYTTEKURUNKONTROLU — tek ürün kontrolü
  newNoOnEdit          Boolean       @default(false) // BYTDUZENLEMEDEYENINOALSIN
  // palet içi palet (üst/parçalı palet) + transfer davranışı
  breakParentPallet         Boolean  @default(false) // BYTUSTPALETBOZULSUN — üst palet bozulsun
  breakPartialPallet        Boolean  @default(false) // BYTPARCALIPALETBOZ — parçalı palet bozulsun
  breakPalletOnTransfer     Boolean  @default(false) // BYTTRANSFERDEPALETIBOZ
  removeFromPalletOnTransfer Boolean @default(false) // BYTTRANSFERDEPALETTENCIKAR
  keepFullPalletOnTransfer  Boolean  @default(false) // BYTTRANSFERTUMPALETKORU
  logging              Boolean       @default(false) // BYTLOGLAMA
  logControl           Boolean       @default(false) // BYTLOGKONTROL
  logControlWarningType Int? // BYTLOGKONTROLUYARITIPI
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company  TBLCOMPANY   @relation(fields: [companyId], references: [id])
  sequence TBLSEQUENCE? @relation(fields: [sequenceId], references: [id])
  pallets  TBLPALLET[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([sequenceId])
  @@schema("wms")
}

model TBLPALLET {
  id             Int       @id @default(autoincrement())
  companyId      Int
  palletNo       String    @db.VarChar(40)
  palletTypeId   Int
  parentPalletId Int?
  baseUnitId     Int?
  originalQty    Decimal?  @db.Decimal(28, 8)
  productionDate DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  beaconId       String?   @db.VarChar(200)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company       TBLCOMPANY        @relation(fields: [companyId], references: [id])
  palletType    TBLPALLETTYPE     @relation(fields: [palletTypeId], references: [id])
  parentPallet  TBLPALLET?        @relation("PalletNesting", fields: [parentPalletId], references: [id])
  childPallets  TBLPALLET[]       @relation("PalletNesting")
  baseUnit      TBLUNIT?          @relation(fields: [baseUnitId], references: [id])
  stocks        TBLSTOCK[]
  documentLines TBLDOCUMENTLINE[]

  @@unique([companyId, palletNo])
  @@index([companyId])
  @@index([palletTypeId])
  @@index([parentPalletId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Stok durumu (legacy STOKDURUM) — STOK KALBİ
// lokasyon × ürün × statü × batch × seri × palet kırılımı
// ----------------------------------------------------------------------------

model TBLSTOCK {
  id             Int       @id @default(autoincrement())
  companyId      Int
  locationId     Int
  productId      Int
  statusId       Int
  palletId       Int?
  batchNo        String?   @db.VarChar(100)
  serialNo       String?   @db.VarChar(100)
  customerId     Int? // cari Faz 2 — şimdilik soft ref (FK yok)
  poNo           String?   @db.VarChar(100)
  poLine         String?   @db.VarChar(100)
  mainQty        Decimal   @default(0) @db.Decimal(28, 8)
  reservedQty    Decimal   @default(0) @db.Decimal(28, 8)
  unitId         Int
  netWeight      Decimal?  @db.Decimal(28, 8)
  grossWeight    Decimal?  @db.Decimal(28, 8)
  productionDate DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  TBLCOMPANY  @relation(fields: [companyId], references: [id])
  location TBLLOCATION @relation(fields: [locationId], references: [id])
  product  TBLPRODUCT  @relation(fields: [productId], references: [id])
  status   TBLSTATUS   @relation(fields: [statusId], references: [id])
  pallet   TBLPALLET?  @relation(fields: [palletId], references: [id])
  unit     TBLUNIT     @relation(fields: [unitId], references: [id])

  @@unique([companyId, locationId, productId, statusId, batchNo, serialNo, palletId, customerId, poNo, poLine])
  @@index([companyId])
  @@index([locationId])
  @@index([productId])
  @@index([statusId])
  @@index([palletId])
  @@index([expiryDate])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Stok Hareket Defteri — append-only ledger (legacy TBLSBLOGBELGE)
// Her mainQty hareketi (belge complete/reverse, sayım eşitleme) buraya yazılır; stok kartı bundan türetilir.
// İlişki taşımaz (append-only; id'ler route/frontend'te çözülür) — minimal bağ, yazım kolaylığı.
// Kolon sırası: ilk 9 görünür kolon liste için optimize (qtyDelta dahil).
// ----------------------------------------------------------------------------
model TBLSTOCKLEDGER {
  id              Int               @id @default(autoincrement())
  companyId       Int
  documentId      Int? // legacy LNGBELGEKOD
  operationTypeId Int? // legacy LNGOPERASYONTIPKOD
  direction       MovementDirection // legacy BYTISLEM/BYTTIP (Giriş/Çıkış/Transfer/Sayım)
  productId       Int // legacy LNGURUNKOD
  locationId      Int // legacy LNGLOKASYONKOD
  statusId        Int
  qtyDelta        Decimal           @db.Decimal(28, 8) // işaretli: + giriş, − çıkış (legacy DBLANAMIKTAR × yön)
  batchNo         String?           @db.VarChar(50) // legacy TXTBATCHNO
  unitId          Int // legacy LNGANABIRIM
  documentLineId  Int? // legacy LNGDETAYKOD
  serialNo        String?           @db.VarChar(50) // legacy TXTSERINO
  palletId        Int?
  poNo            String?           @db.VarChar(50) // legacy TXTPO
  poLine          String?           @db.VarChar(50) // legacy TXTPOLINE
  barcode         String?           @db.VarChar(150) // legacy TXTBARKOD
  userId          Int? // legacy LNGKULLANICIKOD
  createdAt       DateTime          @default(now()) // legacy TRHISLEMTARIHI

  @@index([companyId])
  @@index([companyId, productId])
  @@index([companyId, locationId])
  @@index([documentId])
  @@index([createdAt])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Inventory — min/max stok seviyesi + reorder (MRP girdisi)
// ----------------------------------------------------------------------------

model TBLINVENTORYRULE {
  id           Int      @id @default(autoincrement())
  companyId    Int
  productId    Int
  warehouseId  Int
  minQty       Decimal  @default(0) @db.Decimal(28, 8)
  maxQty       Decimal  @default(0) @db.Decimal(28, 8)
  reorderPoint Decimal  @default(0) @db.Decimal(28, 8)
  reorderQty   Decimal  @default(0) @db.Decimal(28, 8)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   TBLCOMPANY   @relation(fields: [companyId], references: [id])
  product   TBLPRODUCT   @relation(fields: [productId], references: [id])
  warehouse TBLWAREHOUSE @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@schema("wms")
}

// ----------------------------------------------------------------------------
// Cari — müşteri / tedarikçi (legacy MUSTERI/DIST'in iş-ortağı kısmı)
// ----------------------------------------------------------------------------

model TBLBUSINESSPARTNER {
  id             Int         @id @default(autoincrement())
  companyId      Int
  code           String      @db.VarChar(40)
  name           String      @db.VarChar(200)
  type           PartnerType @default(CUSTOMER)
  regionId       Int? // bölge (legacy TBLMSDBOLGE)
  partnerGroupId Int? // cari/müşteri grup (legacy TBLMUSTERIGRUP)
  parentId       Int? // zincir müşteri — üst cari (self-ref)
  taxNumber      String?     @db.VarChar(20)
  phone          String?     @db.VarChar(20)
  email          String?     @db.VarChar(150)
  city           String?     @db.VarChar(60)
  address        String?     @db.VarChar(255)
  // Genel (legacy TBLMUSTERI)
  shortName          String?  @db.VarChar(50)  // Kısa Ad (TXTKISAAD)
  contactPerson      String?  @db.VarChar(100) // İlgili Kişi (TXTILGILIKISI)
  contactPerson2     String?  @db.VarChar(100) // İlgili Kişi 2 (TXTILGILIKISI2)
  specialCode        String?  @db.VarChar(40)  // Özel Kod (TXTOZELKOD)
  // İletişim
  address2           String?  @db.VarChar(255) // Adres 2 (TXTADRES2)
  district           String?  @db.VarChar(60)  // İlçe (TXTILCE)
  postalCode         String?  @db.VarChar(20)  // Posta Kodu (TXTPOSTAKOD)
  country            String?  @db.VarChar(60)  // Ülke (TXTULKE)
  phone2             String?  @db.VarChar(20)  // Telefon 2 (TXTTELEFON2)
  mobilePhone        String?  @db.VarChar(20)  // Cep Tel No (TXTCEPTELNO)
  fax                String?  @db.VarChar(20)  // Faks (TXTFAKS)
  website            String?  @db.VarChar(150) // Web Adresi (TXTWWW)
  // Diğer
  taxOffice          String?  @db.VarChar(100) // Vergi Dairesi (TXTVD)
  nationalId         String?  @db.VarChar(20)  // TC Kimlik No (TXTTCKIMLIKNO)
  licenseOffice      String?  @db.VarChar(100) // Ruhsat Daire (TXTRUHSATDAIRE)
  licenseNo          String?  @db.VarChar(40)  // Ruhsat No (TXTRUHSATNO)
  priorityOrder      Int? // Öncelik Sıra (LNGONCELIKSIRA)
  palletized         Boolean  @default(false)  // Paletli (BYTPALETLI)
  minDeliveryTime    String?  @db.VarChar(10)  // Min. Teslim Zamanı (TXTMINSERVISZAMANI)
  maxDeliveryTime    String?  @db.VarChar(10)  // Max. Teslim Zamanı (TXTMAXSERVISZAMANI)
  vehicleRestriction String?  @db.VarChar(255) // Araç Kısıtlama (TXTARACKISITLAMA)
  // Adres Bilgileri
  street             String?  @db.VarChar(100)    // Cadde (TXTCADDE)
  streetName         String?  @db.VarChar(100)    // Sokak (TXTSOKAK)
  neighborhood       String?  @db.VarChar(100)    // Mahalle (TXTMAHALLE)
  otherAddress       String?  @db.VarChar(255)    // Diğer (TXTDIGER)
  doorNo             String?  @db.VarChar(20)     // Kapı No (TXTKAPINO)
  mapCode            Int? // Harita Kodu (LNGHARITAKOD)
  coordinateX        Decimal? @db.Decimal(18, 8)  // Koordinat X (DBLKOORDINATX)
  coordinateY        Decimal? @db.Decimal(18, 8)  // Koordinat Y (DBLKOORDINATY)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company      TBLCOMPANY           @relation(fields: [companyId], references: [id])
  region       TBLREGION?           @relation(fields: [regionId], references: [id])
  partnerGroup TBLPARTNERGROUP?     @relation(fields: [partnerGroupId], references: [id])
  parent       TBLBUSINESSPARTNER?  @relation("PartnerChain", fields: [parentId], references: [id])
  children     TBLBUSINESSPARTNER[] @relation("PartnerChain")
  documents    TBLDOCUMENT[]
  extraGroupLinks TBLPARTNEREXTRAGROUPLINK[]
  extraFields     TBLPARTNEREXTRAFIELD[]
  acceptanceTimes TBLPARTNERACCEPTANCETIME[]
  optimization    TBLPARTNEROPTIMIZATION[]
